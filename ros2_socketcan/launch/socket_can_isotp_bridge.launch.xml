<launch>

  <arg name="interface" default="can0" />
  <arg name="receiver_interval_sec" default="0.01" />
  <arg name="sender_timeout_sec" default="0.01" />
  <arg name="sender_tx_id" default="1536" />
  <arg name="sender_rx_id" default="1537" />
  <arg name="receiver_tx_id" default="1537" />
  <arg name="receiver_rx_id" default="1536" />
  <arg name="from_can_bus_isotp_topic" default="from_can_bus_isotp" />
  <arg name="to_can_bus_isotp_topic" default="to_can_bus_isotp" />

  <include file="$(find-pkg-share ros2_socketcan)/launch/socket_can_isotp_receiver.launch.py">
    <arg name="interface" value="$(var interface)" />
    <arg name="interval_sec" value="$(var receiver_interval_sec)" />
    <arg name="tx_id" value="$(var receiver_tx_id)" />
    <arg name="rx_id" value="$(var receiver_rx_id)" />
    <arg name="from_can_bus_isotp_topic" value="$(var from_can_bus_isotp_topic)" />
  </include>

  <include file="$(find-pkg-share ros2_socketcan)/launch/socket_can_isotp_sender.launch.py">
    <arg name="interface" value="$(var interface)" />
    <arg name="timeout_sec" value="$(var sender_timeout_sec)" />
    <arg name="tx_id" value="$(var sender_tx_id)" />
    <arg name="rx_id" value="$(var sender_rx_id)" />
    <arg name="to_can_bus_isotp_topic" value="$(var to_can_bus_isotp_topic)" />
  </include>

</launch>
